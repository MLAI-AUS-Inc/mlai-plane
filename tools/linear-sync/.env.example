# Private runtime configuration; never commit real credentials.
LINEAR_API_KEY=replace-with-read-only-linear-key
PLANE_API_KEY=replace-with-plane-key
CF_ACCESS_CLIENT_ID=replace-with-existing-private-origin-service-id
CF_ACCESS_CLIENT_SECRET=replace-with-existing-private-origin-service-secret
SYNC_STATE_DIR=/absolute/private/path/to/linear-sync-state
