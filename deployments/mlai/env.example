# MLAI Plane deployment based on makeplane/plane v1.4.0.
# Copy this file to .env and replace every REPLACE_WITH_* value before starting.

PLANE_RELEASE=v1.4.0
PLANE_UPSTREAM_COMMIT=917b23a6c16d93fc00cef67900eff2755e8b13f7

# Immutable multi-platform OCI manifest digests captured on 1 August 2026.
PLANE_FRONTEND_IMAGE=makeplane/plane-frontend@sha256:8f0f5ee02169c3435fa178aa60707920bfc398bff2ebbe83e72881c029d5fe56
PLANE_SPACE_IMAGE=makeplane/plane-space@sha256:6ef9b14ca5be4f5e09cae2d452478954e18dd5f6f417a655aac13fa3e502e2d9
PLANE_ADMIN_IMAGE=makeplane/plane-admin@sha256:8fd95429127eaaf9feb47f1e25f7db4e29aad1f66109a19bdd86a19bca660482
PLANE_LIVE_IMAGE=makeplane/plane-live@sha256:046c38a1c091e6bce9ce79cf89a300bd226bd749f8f62e7ba7871ab853455f16
PLANE_BACKEND_IMAGE=makeplane/plane-backend@sha256:fbd4b3cea455df88e5473d01e56162286d5f61991898903d9142a7f502799481
PLANE_PROXY_IMAGE=makeplane/plane-proxy@sha256:53393d2ec8c3cf2585473bcc04342c1a3a5525d61d163da13a613c79793fd600
POSTGRES_IMAGE=postgres@sha256:468d34fefd6338031787c7b8e94078975b3aaf4d66c7ead25c39cd3ba46a15c6
VALKEY_IMAGE=valkey/valkey@sha256:10328d00120dc14fbc87b2ed61b7677ddbb0d011e705361b4788329a0ec69a93
RABBITMQ_IMAGE=rabbitmq@sha256:611107e29cce05c2acd968325d5dcbde7e2fee404970f1ead75fdb22be2821b3
MINIO_IMAGE=minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e

# Staging defaults. Production uses https://admin.mlai.au.
APP_DOMAIN=plane-staging.mlai.au
WEB_URL=https://plane-staging.mlai.au
CORS_ALLOWED_ORIGINS=https://plane-staging.mlai.au
APP_BASE_URL=https://plane-staging.mlai.au
SPACE_BASE_URL=https://plane-staging.mlai.au
ADMIN_BASE_URL=https://plane-staging.mlai.au

# Cloudflare Tunnel connects to this loopback-only listener.
LISTEN_HTTP_PORT=8080
SITE_ADDRESS=:80
TRUSTED_PROXIES=0.0.0.0/0
FILE_SIZE_LIMIT=10485760

# This prefix is valid only when cookies are Secure, host-only, and Path=/.
# COOKIE_DOMAIN must remain unset.
SESSION_COOKIE_NAME=__Host-plane-session
SESSION_COOKIE_AGE=604800
SESSION_SAVE_EVERY_REQUEST=0

SECRET_KEY=REPLACE_WITH_DJANGO_SECRET_KEY
LIVE_SERVER_SECRET_KEY=REPLACE_WITH_LIVE_SERVER_SECRET_KEY
DEBUG=0
GUNICORN_WORKERS=2
PLANE_TELEMETRY_ENABLED=0
ENABLE_SIGNUP=0
DISABLE_WORKSPACE_CREATION=1
ENABLE_MAGIC_LINK_LOGIN=0
ENABLE_EMAIL_PASSWORD=1
API_KEY_RATE_LIMIT=60/minute
AUTHENTICATION_RATE_LIMIT=10/minute
WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=

# Bundled state is for staging and restore drills. Production should replace
# these URLs/credentials with managed PostgreSQL, Valkey, RabbitMQ, and S3.
POSTGRES_USER=plane
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
POSTGRES_DB=plane
PGDATA=/var/lib/postgresql/data
DATABASE_URL=postgresql://plane:REPLACE_WITH_POSTGRES_PASSWORD@plane-db:5432/plane

REDIS_URL=redis://plane-redis:6379/

RABBITMQ_USER=plane
RABBITMQ_PASSWORD=REPLACE_WITH_RABBITMQ_PASSWORD
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:REPLACE_WITH_RABBITMQ_PASSWORD@plane-mq:5672/plane

USE_MINIO=1
MINIO_ENDPOINT_SSL=1
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=REPLACE_WITH_S3_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_S3_SECRET_KEY
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
